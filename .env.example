# Copy to .env (git-ignored). NEVER commit real values (NN-12).
DATAGOV_KEY=
TG_TOKEN=
TG_CHAT_ID=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ORS_KEY=
MG_MODE=live
DB_PATH=data/mandiguard.db

# --- added by Stream A (additive; see HANDOFF) ---
# Nominatim policy needs an identifying User-Agent WITH contact. If empty, Nominatim is skipped.
MG_CONTACT_EMAIL=
# Set to 1 ONLY after gate A1 confirmed that Agmarknet prices are Rs per QUINTAL (NN-15).
MG_PRICE_UNIT_VERIFIED=0
# data.gov.in filter key style for state ("state.keyword" or "state"); A1 decides. Auto-fallback exists.
DATAGOV_STATE_FILTER=state.keyword
